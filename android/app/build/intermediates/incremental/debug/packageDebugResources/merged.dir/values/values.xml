<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="colorAccent">#4fd1c7</color>
    <color name="colorPrimary">#4A0070</color>
    <color name="colorPrimaryDark">#0A0A0F</color>
    <color name="cosmicDark">#CC0A0A0F</color>
    <color name="ic_launcher_background">#16002A</color>
    <string name="app_name">Asket: AI &amp; Spiritual Pacts</string>
    <string name="custom_url_scheme">com.asket.cosmicascension</string>
    <string name="package_name">com.asket.cosmicascension</string>
    <string name="title_activity_main">Asket: AI &amp; Spiritual Pacts</string>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/cosmicDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/cosmicDark</item>
        <item name="android:navigationBarColor">@color/cosmicDark</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/cosmicDark</item>
        <item name="android:navigationBarColor">@color/cosmicDark</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>